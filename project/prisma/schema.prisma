generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  image                 String?
  monthlyIncome         Decimal                @default(0) @db.Decimal(10, 2)
  currency              String                 @default("BRL")
  payday                Int?
  financeProfile        UserFinanceProfile?
  expenseGroups         ExpenseGroup[]
  expenseGroupOverrides ExpenseGroupOverride[]
  expenses              Expense[]
  creditCardPurchases   CreditCardPurchase[]
  extraIncomes          ExtraIncome[]
  savingsAllocations    SavingsAllocation[]
  accounts              Account[]
  sessions              Session[]
  authenticators        Authenticator[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model UserFinanceProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  monthlyIncome Decimal  @default(0) @db.Decimal(10, 2)
  currency      String   @default("BRL")
  paydayStart   Int?
  paydayEnd     Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExpenseGroup {
  id                  String   @id @default(cuid())
  userId              String
  referenceMonth      String   @default("2026-05")
  name                String
  monthlyAmount       Decimal  @default(0) @db.Decimal(10, 2)
  affectsFutureMonths Boolean  @default(false)
  repeatMonths        String?
  color               String   @default("#18181b")
  description         String?
  priority            String   @default("medium")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenses  Expense[]
  creditCardPurchases CreditCardPurchase[]
  overrides ExpenseGroupOverride[]

  @@index([userId, referenceMonth])
}

model ExpenseGroupOverride {
  id             String   @id @default(cuid())
  userId         String
  expenseGroupId String
  referenceMonth String
  name           String
  monthlyAmount  Decimal  @default(0) @db.Decimal(10, 2)
  color          String   @default("#18181b")
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenseGroup ExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Cascade)

  @@unique([expenseGroupId, referenceMonth])
  @@index([userId, referenceMonth])
}

model Expense {
  id             String   @id @default(cuid())
  userId         String
  expenseGroupId String
  creditCardPurchaseId String?
  installmentNumber    Int?
  installmentCount     Int?
  spentAt        DateTime
  title          String
  amount         Decimal  @default(0) @db.Decimal(10, 2)
  behaviorType   String   @default("daily")
  coverageDays   Int      @default(1)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenseGroup       ExpenseGroup        @relation(fields: [expenseGroupId], references: [id], onDelete: Restrict)
  creditCardPurchase CreditCardPurchase? @relation(fields: [creditCardPurchaseId], references: [id], onDelete: Cascade)

  @@index([userId, spentAt])
  @@index([expenseGroupId])
  @@index([creditCardPurchaseId])
}

model CreditCardPurchase {
  id                    String   @id @default(cuid())
  userId                String
  expenseGroupId        String
  kind                  String   @default("credit_card")
  source                String   @default("Cartao de credito")
  purchasedAt           DateTime
  firstInstallmentMonth String
  title                 String
  totalAmount           Decimal  @default(0) @db.Decimal(10, 2)
  installmentAmount     Decimal  @default(0) @db.Decimal(10, 2)
  installmentCount      Int      @default(1)
  description           String?
  paymentDay            Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  expenseGroup ExpenseGroup @relation(fields: [expenseGroupId], references: [id], onDelete: Restrict)
  expenses     Expense[]

  @@index([userId, firstInstallmentMonth])
  @@index([userId, kind, firstInstallmentMonth])
  @@index([expenseGroupId])
}

model ExtraIncome {
  id             String   @id @default(cuid())
  userId         String
  referenceMonth String
  name           String
  amount         Decimal  @default(0) @db.Decimal(10, 2)
  receivedDay    Int?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, referenceMonth])
}

model SavingsAllocation {
  id                  String   @id @default(cuid())
  userId              String
  referenceMonth      String
  amount              Decimal  @default(0) @db.Decimal(10, 2)
  affectsFutureMonths Boolean  @default(false)
  repeatMonths        String?
  description         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, referenceMonth])
  @@index([userId, referenceMonth])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}
